# Copy this file to deploy/public.env and fill in your own values.
# deploy/public.env is git-ignored.

# Your free ngrok static domain (ngrok dashboard > Domains), without https://
NGROK_DOMAIN=your-name.ngrok-free.app

# Your Vercel website address, with https://, no trailing slash.
# Several addresses: separate them with commas.
FRONTEND_ORIGIN=https://your-project.vercel.app
